{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-delta.v2.schema.json",
  "title": "Catalog Delta v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "previous_bundle_fingerprint",
    "bundle_fingerprint",
    "changed",
    "catalog_root",
    "environment",
    "roots",
    "known_root_cause_candidates",
    "current_page_manifest",
    "edges",
    "unresolved_references",
    "closure_status",
    "closure_complete",
    "reference_extractor_version",
    "changes",
    "freshness_proof"
  ],
  "properties": {
    "schema_version": { "const": "catalog-delta.v2" },
    "contract": { "const": "qts-fact-catalog.v1" },
    "previous_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "changed": { "type": "boolean" },
    "catalog_root": {
      "$ref": "catalog-bundle.v2.schema.json#/$defs/catalogRoot"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "catalog-bundle.v2.schema.json#/$defs/rootResult" }
    },
    "known_root_cause_candidates": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "catalog-bundle.v2.schema.json#/$defs/candidate" }
    },
    "current_page_manifest": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/manifestItem" }
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "catalog-bundle.v2.schema.json#/$defs/edge" }
    },
    "unresolved_references": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "catalog-bundle.v2.schema.json#/$defs/unresolvedReference"
      }
    },
    "closure_status": {
      "$ref": "catalog-bundle.v2.schema.json#/$defs/closureStatus"
    },
    "closure_complete": { "type": "boolean" },
    "reference_extractor_version": {
      "const": "qts-fact-catalog-extractor.v2.0.0"
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "updated", "removed", "unchanged"],
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "catalog-bundle.v2.schema.json#/$defs/page" }
        },
        "updated": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["previous", "current"],
            "properties": {
              "previous": { "$ref": "#/$defs/manifestItem" },
              "current": {
                "$ref": "catalog-bundle.v2.schema.json#/$defs/page"
              }
            }
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/manifestItem" }
        },
        "unchanged": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/manifestItem" }
        }
      }
    },
    "freshness_proof": { "$ref": "catalog-freshness-proof.v2.schema.json" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "updated_at", "content_sha256"],
      "properties": {
        "page_id": { "type": "string", "format": "uuid" },
        "updated_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
