{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-freshness-proof.v3.schema.json",
  "title": "Catalog Freshness Proof v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_algorithm",
    "public_key_format",
    "public_key",
    "key_id",
    "resolution_ticket_id",
    "challenge",
    "resolution_started_at",
    "verified_at",
    "resolution_elapsed_ms",
    "snapshot_fetched_at",
    "catalog_root_page_id",
    "environment",
    "authorization_context_sha256",
    "requested_roots",
    "isolation",
    "read_only",
    "page_manifest",
    "reference_extractor_version",
    "bundle_fingerprint",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "catalog-freshness-proof.v3" },
    "signature_algorithm": { "const": "ed25519" },
    "public_key_format": { "const": "spki-der-base64url" },
    "public_key": { "type": "string", "minLength": 32, "maxLength": 256 },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "resolution_ticket_id": { "type": "string", "format": "uuid" },
    "challenge": { "type": "string", "minLength": 16, "maxLength": 128 },
    "resolution_started_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "resolution_elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    },
    "snapshot_fetched_at": { "type": "string", "format": "date-time" },
    "catalog_root_page_id": { "type": "string", "format": "uuid" },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "authorization_context_sha256": { "$ref": "#/$defs/sha256" },
    "requested_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/rootSelector" }
    },
    "isolation": { "const": "repeatable_read" },
    "read_only": { "const": true },
    "page_manifest": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/manifestItem" }
    },
    "reference_extractor_version": {
      "const": "qts-fact-catalog-extractor.v3.0.0"
    },
    "bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "minLength": 64, "maxLength": 256 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rootSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_id"],
          "properties": { "page_id": { "type": "string", "format": "uuid" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_type", "entity_id"],
          "properties": {
            "document_type": { "type": "string", "minLength": 1 },
            "entity_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "updated_at",
        "content_sha256",
        "front_matter_sha256"
      ],
      "properties": {
        "page_id": { "type": "string", "format": "uuid" },
        "updated_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "front_matter_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
